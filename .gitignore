__pycache__/
*.py[cod]
.DS_Store
.pytest_cache/
.coverage
.env
.env.*
!.env.example

# Model weights and TensorRT engines are large, machine-specific build
# artifacts. Rebuild them on the Jetson with
# robot/jetson/perception/build_engine.py; provenance and checksums are
# recorded in robot/jetson/perception/README.md.
*.onnx
*.engine
*.engine.json
models/

# Local robot calibration captures contain machine-specific test data.
calibration/*.json

# Development logs with failure history - keep locally, exclude from public repo
docs/DEVELOPMENT_LOG.md
share/reference_docs/docs/DEVELOPMENT_LOG.md

# Mission replay failure analysis
docs/MISSION_REPLAY.md
share/reference_docs/docs/MISSION_REPLAY.md

# Failure-to-fix cases documentation
share/10_DECISIONS_AND_FAILURE_TO_FIX_CASES.md

# Reference docs copies - not needed in public repo
share/reference_docs/

# The communication app is maintained separately from the robot repository.
communication/
